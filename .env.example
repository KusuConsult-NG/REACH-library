# Copy to .env.local and fill in for a deployment against real services.
# With both unset the app runs entirely on seeded local data — which is what
# makes the demo build installable and fully explorable offline.

# Base URL of the REACH Express proxy that fronts Koha and the university IdP.
# Example: https://reach-api.unijos.edu.ng/api
VITE_API_BASE_URL=

# EZproxy-style prefix used to authenticate off-campus e-resource access.
# The target URL is appended, percent-encoded.
# Example: https://ezproxy.unijos.edu.ng/login?url=
VITE_PROXY_BASE=
