# Copy to .env and load it however you run the process (systemd, docker, direnv…).
# With KOHA_BASE_URL and IDP_TOKEN_URL unset, the proxy runs on a fixture
# catalogue and accepts development identities — useful before credentials
# exist, and refused outright when NODE_ENV=production.

NODE_ENV=development
PORT=8080

# Signs session tokens. REQUIRED in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# Origins allowed to call this API. Leave empty when the PWA is served from
# the same origin as the proxy.
CORS_ORIGINS=http://localhost:5173

# Koha REST API. The client credentials stay here and never reach a browser.
KOHA_BASE_URL=
KOHA_CLIENT_ID=
KOHA_CLIENT_SECRET=
KOHA_TIMEOUT_MS=8000

# University identity provider (OAuth 2.0).
IDP_TOKEN_URL=
IDP_USERINFO_URL=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# Where bookings, consultations and the XP ledger are stored.
DATA_FILE=data/reach.json
